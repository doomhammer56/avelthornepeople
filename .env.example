# Staff server connection (dedicated login with portal_runtime, never migration credentials)
DATABASE_URL=

# Public server connection (separate login with portal_public_reader)
PUBLIC_DATABASE_URL=

# Migration connection
DIRECT_URL=

# All four application pools verify TLS certificates and hostnames by default.
# Optional project CA PEM from a trusted administrative source (literal or escaped newlines).
# Set this before deployment if the project's certificate chain is not publicly trusted.
DATABASE_TLS_CA=
# Development only: permits plaintext solely for localhost/127.0.0.1/::1 endpoints.
DATABASE_ALLOW_LOCAL_PLAINTEXT=false

# Database test identity
TEST_STAFF_USER_ID=

# Supabase Storage / Auth API 
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server only: never prefix with NEXT_PUBLIC_ or send to a browser
SUPABASE_SECRET_KEY=

# Server-only candidate encryption and contact matching. Never use NEXT_PUBLIC_.
# Each keyring is a JSON object: {"1":"<independent random 32-byte base64 key>"}.
CANDIDATE_ENCRYPTION_KEYS=
CANDIDATE_MATCH_KEYS=
CANDIDATE_ACTIVE_KEY_VERSION=1

# Public origin used for metadata, sitemap.xml and JobPosting structured data.
# Only needed for a custom domain: on Vercel this falls back to the deployment's
# own URL automatically (preview and production), and to localhost otherwise.
PUBLIC_SITE_URL=

# preview: design fixtures; database: local restricted public views; api: external backend.
PUBLIC_JOBS_SOURCE=preview

# Only required for PUBLIC_JOBS_SOURCE=api. The local database mode calls the shared
# jobs service directly; GET /api/jobs and GET /api/jobs/{slug} expose the same DTOs.
# The jobs collection API must support page/pageSize, filters and paged facets,
# and return jobs,total,page,pageSize,totalPages,facets (the in-repo API does).
# This server-only value contains no credentials and is never bundled into client code.
PUBLIC_API_BASE_URL=

# Separate restricted login with only portal_metrics_writer; never use DATABASE_URL/DIRECT_URL.
ANALYTICS_DATABASE_URL=

# Expiry Cron: separate login with only portal_jobs_worker; server-only.
JOBS_WORKER_DATABASE_URL=
## Privacy cleanup: separate NOINHERIT login with only portal_privacy_worker.
## Required before enabling the privacy cron; never use DATABASE_URL here.
PRIVACY_WORKER_DATABASE_URL=
# 32+ random characters, sent as Authorization: Bearer by the scheduler.
CRON_SECRET=

# Staff console origin (exact HTTPS origin in deployment; localhost in development)
AUTH_APP_ORIGIN=http://localhost:3000
# Cloudflare Turnstile (public job application form): site key may be exposed to the client.
AUTH_TURNSTILE_SITE_KEY=
# Server-only: verify application submissions (use TURNSTILE_SECRET_KEY or AUTH_TURNSTILE_SECRET).
# When unset, verification is skipped (local dev only; set in production).
TURNSTILE_SECRET_KEY=
AUTH_TURNSTILE_SECRET=
# Stable shared server-only secret (32+ characters); also required in .env.test.
# Hashes login/traffic identifiers. Rotation needs an explicit state migration;
# never generate a new value on app startup or redeploy (would bypass locks).
AUTH_LIMITER_SECRET=
# Only set when your hosting proxy strips/replaces this header reliably:
# x-vercel-forwarded-for or cf-connecting-ip; blank shares a local-development bucket
AUTH_TRUSTED_IP_HEADER=
# In .env.test only: explicit test project ID, checked before hosted fixtures
AUTH_TEST_PROJECT_REF=
